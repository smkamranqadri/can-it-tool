# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env
.env.*

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Model weights: never commit these. They are gigabytes and are not ours to
# redistribute. Point --base-url at a server that has already loaded one.
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
models/

# Benchmark output. Runs are large (roughly 1 MB per model at runs=1, because
# every trace is retained) and are reproducible from the CLI. Published runs
# belong on a GitHub Release, not in git history.
results/*.json
results/*.html
results/latency/*.json
results/latency/mon/
results/load/
# Result JSON copied from another machine for cross-machine comparison
results/m2/

# Separate environment for the Laya adapters (torch is not a project dependency)
.laya-venv/
# Separate environment for the classifier router (sklearn, no torch)
.router-venv/

# Router training data and fitted model: deterministic and regenerable from
# scripts/router_data.py and scripts/router_train.py, so the scripts are the source.
data/*.jsonl
data/*.pkl
# The fine-tuned router model: 88 MB of weights, regenerated by
# scripts/router_train_minilm.py (seeded, so a retrain reproduces it).
data/router_minilm/

# Local server logs and scratch
*.log
scratch/
tmp/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
